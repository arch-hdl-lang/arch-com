#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Skip entirely for delete-only pushes (`git push --delete`): there are no new
# commits to review or claim-check, and the branch being deleted is unrelated
# to whatever branch happens to be checked out.
deleting_only=1
zero="0000000000000000000000000000000000000000"
pushed=()   # "<local_sha> <remote_sha>" per non-delete ref
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ -z "${local_sha:-}" ]] && continue
  [[ "$local_sha" == "$zero" ]] && continue
  deleting_only=0
  pushed+=("$local_sha ${remote_sha:-$zero}")
done
[[ "$deleting_only" == 1 ]] && exit 0

# Blocking rustfmt check, mirroring the `rustfmt` CI workflow, so an
# unformatted push fails here instead of in CI. It checks the *pushed commit's*
# contents (not the working tree, which may hold uncommitted edits) for every
# `.rs` file the push changes, using the pinned toolchain from
# rust-toolchain.toml. Skip with FMT_CHECK_SKIP=1; skipped with a warning if
# rustfmt is not installed.
fmt_check() {
  [[ "${FMT_CHECK_SKIP:-0}" == 1 ]] && return 0
  if ! rustfmt --version >/dev/null 2>&1; then
    echo "pre-push: rustfmt not available; skipping format check" >&2
    return 0
  fi
  local edition
  edition="$(sed -n 's/^edition *= *"\([0-9]*\)".*/\1/p' Cargo.toml | head -1)"
  local bad=() entry local_sha remote_sha base f
  for entry in "${pushed[@]}"; do
    read -r local_sha remote_sha <<<"$entry"
    if [[ "$remote_sha" != "$zero" ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
      base="$remote_sha"
    else
      # New branch: compare against where it forked from main.
      base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    fi
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      # On stdin, `rustfmt --check` prints the diff but still exits 0, so treat
      # any output (a diff, or a parse error) or a non-zero exit as a failure.
      local out rc=0
      out="$(git show "$local_sha:$f" | rustfmt --check --edition "${edition:-2021}" 2>&1)" || rc=$?
      if [[ "$rc" != 0 || -n "$out" ]]; then
        bad+=("$f")
      fi
    done < <(
      if [[ -n "$base" ]]; then
        git diff --name-only --diff-filter=ACMR "$base" "$local_sha" -- '*.rs'
      else
        # (ls-tree pathspecs are literal prefixes, not globs — filter instead.)
        git ls-tree -r --name-only "$local_sha" | grep '\.rs$' || true
      fi
    )
  done
  if [[ ${#bad[@]} -gt 0 ]]; then
    echo "pre-push: rustfmt check failed — these files are not formatted:" >&2
    printf '  %s\n' "${bad[@]}" | sort -u >&2
    echo "  Run \`cargo fmt --all\`, commit, and push again (CI's rustfmt job would fail)." >&2
    echo "  Bypass for this push only: FMT_CHECK_SKIP=1 git push ..." >&2
    return 1
  fi
}
fmt_check

# Blocking testbench-registration check, mirroring the `tb-registered` CI
# workflow: every `*_tb.cpp` in the pushed commit must be in
# tests/arch_sim_manifest.json (or the script's ALLOWLIST), and every manifest
# tb_files path must exist. Runs scripts/check_tb_registered.sh --rev on each
# pushed commit, so only committed files count. Skip with TB_CHECK_SKIP=1.
tb_check() {
  [[ "${TB_CHECK_SKIP:-0}" == 1 ]] && return 0
  local script=scripts/check_tb_registered.sh entry local_sha _remote_sha
  if [[ ! -x "$script" ]] || ! command -v python3 >/dev/null 2>&1; then
    echo "pre-push: $script or python3 unavailable; skipping testbench check" >&2
    return 0
  fi
  for entry in "${pushed[@]}"; do
    read -r local_sha _remote_sha <<<"$entry"
    # The allowlist lives in the script itself; if the pushed commit carries a
    # different version of it than this checkout, the verdict would be wrong.
    if ! git show "$local_sha:$script" 2>/dev/null | cmp -s - "$script"; then
      echo "pre-push: $script differs between ${local_sha:0:8} and this checkout; skipping testbench check" >&2
      continue
    fi
    if ! "$script" --rev "$local_sha" >/dev/null; then
      echo "  (pre-push: ${local_sha:0:8} would fail CI's \`tb registered\` check." >&2
      echo "   Bypass for this push only: TB_CHECK_SKIP=1 git push ...)" >&2
      return 1
    fi
  done
}
tb_check

branch="$(git branch --show-current)"

# Advisory duplicate-work check (never blocks). Skip with CLAIM_CHECK_SKIP=1.
claim_check() {
  [[ "${CLAIM_CHECK_SKIP:-0}" == 1 ]] && return 0
  scripts/claim_check.sh || true
}

case "$branch" in
  codex/*)
    scripts/pre_pr_review.sh check   # blocking: require a code-review marker
    claim_check                       # advisory: warn on duplicate parallel work
    ;;
  claude/*)
    claim_check                       # advisory: mirror dup-check for claude branches
    ;;
  *)
    ;;
esac
