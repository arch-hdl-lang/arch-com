// Vacuity guard: contradictory `assume` clauses make the constrained state
// space EMPTY, so a negated-property miter is trivially unsat and WOULD
// report a false PROVED. arch formal must instead detect the unsatisfiable
// assumptions and report VACUOUS (a hard failure, exit 1) — never a pass.
// `bogus` is false for a=NaN and refutes without the assumes.
module FpVacuous
  port clk: in Clock<Sys>;
  port rst: in Reset<Sync>;
  port a: in FP8E4M3;
  port o: out Bool;
  comb o = is_nan(a); end comb
  assume bad1: a >= 1.0;
  assume bad2: a <= 0.0;
  assert bogus: !is_nan(a);
end module FpVacuous
