//! Regression fixture for arch#1058: non-power-of-two FIFO DEPTH.
//!
//! DEPTH=1 sync FIFO. The pre-fix SV codegen assumed a power-of-two
//! DEPTH: the `wr_ptr[PTR_W-2:0]` slice degenerates to `[-1:0]` and
//! `full` never asserts, so the emitted SV accepted unbounded pushes
//! while arch sim correctly capped the FIFO at one entry.

domain SysDomain
  freq_mhz: 100
end domain SysDomain

fifo FifoCapD1
  param DEPTH: const = 1;
  param T: type = UInt<8>;
  port clk: in Clock<SysDomain>;
  port rst: in Reset<Sync>;
  port push_valid: in Bool;
  port push_ready: out Bool;
  port push_data: in T;
  port pop_valid: out Bool;
  port pop_ready: in Bool;
  port pop_data: out T;
  port full: out Bool;
  port empty: out Bool;
end fifo FifoCapD1
